# ==============================================================================
# VisionForge Studio - Environment Configuration Template
# Copy this file to .env and configure your local or cloud environment.
# ==============================================================================

# Core Application Settings
APP_NAME="VisionForge Studio"
APP_ENV=development
DEBUG=true
VERSION=1.0.0

# Server Binding
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# Database Configuration (Defaults to SQLite in data/visionforge.db)
# DATABASE_URL=sqlite:///data/visionforge.db
# DATABASE_URL=postgresql://user:password@localhost:5432/visionforge

# Optional Custom Site-Packages Override
# CUSTOM_SITE_PACKAGES=/path/to/virtualenv/site-packages

# Cloud Accelerator Integration: Kaggle Cloud Dual-T4
# Set either KAGGLE_API_TOKEN (Personal Access Token KGAT-...) or KAGGLE_KEY (Legacy)
# Leave blank to enter via the VisionForge UI Settings modal.
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
KAGGLE_KEY=

# Model Weights Directories (Optional)
# AURELIX_WEIGHTS_DIR=./weights/aurelix
# MHYRA_WEIGHTS_DIR=./weights/mhyra
